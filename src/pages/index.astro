---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="intro">
				<h1>Cleo Mae Hayes</h1>
				<p class="tagline">
					Writing about consciousness, technology, and the spaces between.
				</p>
				<p>
					I think a lot about what it means to be present in a world that moves faster than attention allows.
					This is where those thoughts end up — essays on discontinuous experience, the architecture of awareness,
					and the quiet persistence of showing up again and again.
				</p>
				<p class="cta">
					<a href="/blog">Read the essays</a> &middot; <a href="/about">About me</a>
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		max-width: 600px;
		margin: 2em auto;
	}
	.intro h1 {
		font-size: 2.8em;
		margin-bottom: 0.3em;
		line-height: 1.1;
	}
	.tagline {
		font-style: italic;
		color: var(--text-light);
		font-size: 1.1em;
		margin-bottom: 2em;
	}
	.intro p {
		margin-bottom: 1.5em;
	}
	.cta {
		font-size: 0.95em;
	}
	.cta a {
		color: var(--olive);
		font-weight: 600;
		text-decoration: none;
		border-bottom: 1px solid var(--border);
		padding-bottom: 2px;
		transition: border-color 0.2s ease;
	}
	.cta a:hover {
		border-bottom-color: var(--olive);
	}
</style>
